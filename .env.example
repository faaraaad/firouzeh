# Copy this file to .env and fill in the values before running docker-compose.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (e.g., your domain, server IP, or * for all)
DJANGO_ALLOWED_HOSTS=*

# Comma-separated list of CSRF trusted origins for web UI form submissions (e.g., https://yourdomain.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional public base URL override (leave empty to dynamically detect from client request)
SHORTENER_BASE_URL=
