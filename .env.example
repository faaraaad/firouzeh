# Copy this file to .env and fill in the values before running docker-compose.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (e.g., your domain or server IP)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL of the service (used to build short URLs in API responses)
SHORTENER_BASE_URL=http://localhost:9000
